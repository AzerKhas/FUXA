    "svgcontent": "<svg width=\"1280\" height=\"720\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\" xmlns:html=\"http://www.w3.org/1999/xhtml\">\n <filter height=\"200\" width=\"200\" y=\"-3\" x=\"-3\" id=\"blur-filter\">\n  <feGaussianBlur stdDeviation=\"3\"/>\n </filter>\n <g>\n  <title>Layer 1</title>\n  <g data-name=\"courbes_date_debut\" stroke=\"#000000\" fill=\"#FFFFFF\" type=\"svg-ext-html_input\" id=\"HXI_ccbe5398-143e4dbd\">\n   <rect id=\"svg_a0758efc-353d4d3e\" height=\"32\" width=\"230\" y=\"90\" x=\"90\" stroke-width=\"0.5\"/>\n   <foreignObject id=\"H-HXI_562c068f-e84d442f\" width=\"230\" height=\"32\" y=\"90\" x=\"90\">\n    <INPUT style=\"width: calc(100% - 7px); height: calc(100% - 7px); text-align: right; border: unset; font-size: 14px; font-family: sans-serif; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);\" value=\"#.##\" type=\"text\" id=\"I-HXI_562c068f-e84d442f\"/>\n   </foreignObject>\n  </g>\n  <g data-name=\"courbes_date_fin\" stroke=\"#000000\" fill=\"#FFFFFF\" type=\"svg-ext-html_input\" id=\"HXI_eb8ecc97-34c84bc8\">\n   <rect id=\"svg_27f9373c-a4f440cf\" height=\"32\" width=\"230\" y=\"90\" x=\"400\" stroke-width=\"0.5\"/>\n   <foreignObject id=\"H-HXI_354288f7-79d84712\" width=\"230\" height=\"32\" y=\"90\" x=\"400\">\n    <INPUT style=\"width: calc(100% - 7px); height: calc(100% - 7px); text-align: right; border: unset; font-size: 14px; font-family: sans-serif; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);\" value=\"#.##\" type=\"text\" id=\"I-HXI_354288f7-79d84712\"/>\n   </foreignObject>\n  </g>\n  <g stroke=\"rgba(0,0,0,0)\" fill=\"rgba(0,0,0,0)\" type=\"svg-ext-html_button\" id=\"HXB_318dd681-30214b62\">\n   <rect id=\"svg_9eb58a8e-fbef4ddf\" height=\"32\" width=\"140\" y=\"90\" x=\"670\" stroke-width=\"0\"/>\n   <foreignObject id=\"H-HXB_004e4c6e-0b1347be\" width=\"140\" height=\"32\" y=\"90\" x=\"670\">\n    <BUTTON style=\"width:calc(100% - 6px);height:calc(100% - 6px);text-align:center;background-color:#FFFFFF;color:#000000;font-size:14px;font-family:sans-serif;\" class=\"md-btn  md-btn-raised\" id=\"B-HXB_004e4c6e-0b1347be\">AFFICHER</BUTTON>\n   </foreignObject>\n  </g>\n  <g data-name=\"courbe_tendances\" text-anchor=\"right\" font-family=\"sans-serif\" font-size=\"14\" stroke=\"#000000\" fill=\"#FFFFFF\" type=\"svg-ext-html_chart\" id=\"HXC_39d12bdf-a20a46b0\">\n   <rect id=\"svg_e9c9315d-f8c04ad9\" height=\"520\" width=\"1200\" y=\"150\" x=\"40\" stroke-width=\"0\"/>\n   <foreignObject id=\"H-HXC_c8d8fbee-fa484a40\" width=\"1200\" height=\"520\" y=\"150\" x=\"40\">\n    <DIV style=\"width:100%;height:100%;\" id=\"D-HXC_c8d8fbee-fa484a40\">\n     <CHART-UPLOT class=\"ng-star-inserted\">\n      <DIV style=\"background-color: rgba(255, 255, 255, 0);\" class=\"mychart-panel\">\n       <!--bindings={\n  \"ng-reflect-ng-if\": \"false\"\n}-->\n       <NGX-UPLOT class=\"mychart-graph\">\n        <DIV>\n         <DIV class=\"uplot u-hz\">\n          <DIV style=\"color: rgb(0, 0, 0); font-size: 18px; font-family: Roboto-Regular;\" class=\"u-title\">Title</DIV>\n          <DIV style=\"width: 1200px; height: 440px;\" class=\"u-wrap\">\n           <DIV style=\"left: 25px; top: 0px; width: 1150px; height: 360px;\" class=\"u-under\"></DIV>\n           <CANVAS height=\"550\" width=\"1500\"/>\n           <DIV style=\"left: 25px; top: 0px; width: 1150px; height: 360px;\" class=\"u-over\">\n            <DIV style=\"transform: translate(-10px, 0px);\" class=\"u-cursor-x u-off\"></DIV>\n            <DIV style=\"transform: translate(0px, -10px);\" class=\"u-cursor-y u-off\"></DIV>\n            <DIV class=\"u-select\"></DIV>\n            <DIV style=\"width: 5px; height: 5px; margin-left: -2.5px; margin-top: -2.5px; transform: translate(-10px, -10px);\" class=\"u-cursor-pt u-off\"></DIV>\n           </DIV>\n           <DIV style=\"top: 360px; height: 50px; left: 25px; width: 1150px;\" class=\"u-axis\"></DIV>\n           <DIV class=\"u-axis u-off\"></DIV>\n           <DIV class=\"u-axis u-off\"></DIV>\n           <DIV class=\"u-axis u-off\"></DIV>\n           <DIV class=\"u-axis u-off\"></DIV>\n          </DIV>\n          <TABLE style=\"color: rgb(0, 0, 0); line-height: 0;\" class=\"u-legend u-inline u-live\">\n           <TBODY>\n            <TR class=\"u-series\">\n             <TH>\n              <DIV class=\"u-marker\"></DIV>\n              <DIV class=\"u-label\">Time</DIV>\n             </TH>\n             <TD class=\"u-value\">01/01/1970 1:00:00 AM</TD>\n            </TR>\n            <TR class=\"u-series\">\n             <TH>\n              <DIV style=\"border: 2px solid red; background: rgba(255, 0, 0, 0.3);\" class=\"u-marker\"></DIV>\n              <DIV class=\"u-label\">Serie</DIV>\n             </TH>\n             <TD class=\"u-value\">--</TD>\n            </TR>\n           </TBODY>\n          </TABLE>\n         </DIV>\n        </DIV>\n       </NGX-UPLOT>\n       <!--bindings={\n  \"ng-reflect-ng-if\": \"false\"\n}-->\n       <!--bindings={\n  \"ng-reflect-ng-if\": \"false\"\n}-->\n      </DIV>\n     </CHART-UPLOT>\n    </DIV>\n   </foreignObject>\n  </g>\n  <text font-family=\"Arial\" font-weight=\"bold\" fill=\"#0D47A1\" font-size=\"28\" y=\"50\" x=\"40\" id=\"svg_courbes_titre\">COURBES</text>\n  <text font-family=\"Arial\" font-weight=\"bold\" fill=\"#000000\" font-size=\"15\" y=\"112\" x=\"40\" id=\"svg_courbes_du\">Du :</text>\n  <text font-family=\"Arial\" font-weight=\"bold\" fill=\"#000000\" font-size=\"15\" y=\"112\" x=\"350\" id=\"svg_courbes_au\">Au :</text>\n  <text font-family=\"Arial\" font-weight=\"normal\" fill=\"#5D4037\" font-size=\"13\" y=\"700\" x=\"40\" id=\"svg_courbes_note\">Courbe vide pour le moment : elle sera reliée à la base de données PostgreSQL.</text>\n  <g xml:space=\"preserve\" stroke=\"rgba(0,0,0,0)\" fill=\"rgba(0,0,0,0)\" type=\"svg-ext-html_button\" id=\"HXB_cf7b5cbd-766042bf\">\n   <rect id=\"svg_caf6c1ba-caf74f64\" height=\"34\" width=\"170\" y=\"25\" x=\"1070\