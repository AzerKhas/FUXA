    "svgcontent": "<svg width=\"1280\" height=\"720\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\" xmlns:html=\"http://www.w3.org/1999/xhtml\">\n <filter id=\"blur-filter\" x=\"-3\" y=\"-3\" width=\"200\" height=\"200\">\n  <feGaussianBlur stdDeviation=\"3\"/>\n </filter>\n <g>\n  <title>Layer 1</title>\n  <g data-name=\"hist_date_debut\" id=\"HXI_d9effa97-6b7a4732\" type=\"svg-ext-html_input\" fill=\"#FFFFFF\" stroke=\"#000000\">\n   <rect stroke-width=\"0.5\" x=\"90\" y=\"90\" width=\"230\" height=\"32\" id=\"svg_cf5f69fe-6fff4b41\"/>\n   <foreignObject x=\"90\" y=\"90\" height=\"32\" width=\"230\" id=\"H-HXI_7a63e282-9ba148e9\">\n    <INPUT style=\"width: calc(100% - 7px); height: calc(100% - 7px); text-align: right; border: unset; font-size: 14px; font-family: sans-serif; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);\" value=\"#.##\" type=\"text\" id=\"I-HXI_7a63e282-9ba148e9\"/>\n   </foreignObject>\n  </g>\n  <g data-name=\"hist_date_fin\" id=\"HXI_0df5ef23-a5424ef9\" type=\"svg-ext-html_input\" fill=\"#FFFFFF\" stroke=\"#000000\">\n   <rect stroke-width=\"0.5\" x=\"400\" y=\"90\" width=\"230\" height=\"32\" id=\"svg_6fb6f6dd-13ab4d91\"/>\n   <foreignObject x=\"400\" y=\"90\" height=\"32\" width=\"230\" id=\"H-HXI_0cfefbf4-055d47d7\">\n    <INPUT style=\"width: calc(100% - 7px); height: calc(100% - 7px); text-align: right; border: unset; font-size: 14px; font-family: sans-serif; background-color: rgb(255, 255, 255); color: rgb(0, 0, 0);\" value=\"#.##\" type=\"text\" id=\"I-HXI_0cfefbf4-055d47d7\"/>\n   </foreignObject>\n  </g>\n  <g id=\"HXB_d2f66905-b973495c\" type=\"svg-ext-html_button\" fill=\"rgba(0,0,0,0)\" stroke=\"rgba(0,0,0,0)\">\n   <rect stroke-width=\"0\" x=\"670\" y=\"90\" width=\"140\" height=\"32\" id=\"svg_bd1af160-6b5a43aa\"/>\n   <foreignObject x=\"670\" y=\"90\" height=\"32\" width=\"140\" id=\"H-HXB_f4d36732-61e54439\">\n    <BUTTON style=\"width:calc(100% - 6px);height:calc(100% - 6px);text-ali